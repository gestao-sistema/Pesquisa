# Copie para .env ao rodar localmente. No Railway, o DATABASE_URL e a PORT
# são injetados sozinhos quando você adiciona o plugin PostgreSQL — o resto
# só precisa ser definido se você quiser mudar o padrão.

# ---- Banco ----
# Sem esta variável o servidor sobe assim mesmo: as respostas caem para o
# localStorage do navegador e as contas ficam só em memória (perdidas ao
# reiniciar). Útil para mexer no visual sem instalar banco.
DATABASE_URL=postgres://usuario:senha@localhost:5432/desligamento

# Porta do servidor. O Railway define sozinho; local, o padrão é 3000.
PORT=3000

# ---- Contas iniciais ----
# Criadas no primeiro boot, apenas se a tabela de usuários estiver vazia.
# Ambas entram com senha provisória e são obrigadas a trocá-la no primeiro
# acesso. Depois disso, estas variáveis não têm mais efeito.
#
# Defina SENHA_INICIAL no Railway para que a senha de partida não fique
# registrada no repositório. O padrão embutido é AZIME2026.
EMAIL_RH=RH@azime.com.br
EMAIL_TI=TI@azime.com.br
SENHA_INICIAL=AZIME2026

# ---- Sessão ----
# Horas até a sessão expirar. Ela se renova sozinha enquanto a pessoa usa
# o painel; este é o limite de inatividade.
HORAS_SESSAO=12

# ---- Alavanca de emergência ----
# Só o TI redefine senha, e só outro TI redefiniria a do TI. Com uma única
# conta de TI, esquecer a senha trancaria a administração para sempre.
#
# Para destravar: defina esta variável, reinicie o serviço, entre com essa
# senha (o sistema vai pedir uma nova) e DEPOIS REMOVA A VARIÁVEL. Enquanto
# ela existir, todo reinício redefine a senha do TI — o servidor avisa no log.
# Deixe comentada em operação normal.
# RESET_SENHA_TI=

# ---- Dados de exemplo ----
# O botão "Carregar dados de exemplo" grava 160 respostas fictícias. Sem
# banco é inofensivo (fica no navegador); com Postgres ligado ele é
# bloqueado, para não sujar a base real. Só defina como true num ambiente
# de teste com banco próprio.
# PERMITIR_DEMO=false
